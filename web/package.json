{
  "name": "teleskope-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "node scripts/prepare-e2e.mjs && playwright test",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run src",
    "format": "prettier --write src"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  },
  "dependencies": {
    "vue": "3.5.43"
  }
}
